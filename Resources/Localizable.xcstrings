    "Expected maximum temperatures up to %@ with high bioclimatic stress. Avoid exposure during peak hours and stay hydrated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected maximum temperatures up to %@ with high bioclimatic stress. Avoid exposure during peak hours and stay hydrated."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previste temperature massime fino a %@ con elevato stress bioclimatico. Evitare l'esposizione nelle ore centrali e idratarsi."
          }
        }
      }
    },
    "Expected minimum temperatures down to %@ with frost and ground icing risk. Exercise extreme caution while driving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected minimum temperatures down to %@ with frost and ground icing risk. Exercise extreme caution while driving."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previste temperature minime fino a %@ con rischio di gelate e ghiaccio al suolo. Prestare la massima attenzione alla guida."
          }
        }
      }
    },
    "Expected wind gusts up to %@ with possible disruption to travel and rough seas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected wind gusts up to %@ with possible disruption to travel and rough seas."
