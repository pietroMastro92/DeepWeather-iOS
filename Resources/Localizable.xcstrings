          "stringUnit": {
            "state": "translated",
            "value": "Previste raffiche di vento fino a %@ con possibili disagi alla viabilità e mareggiate."
          }
        }
      }
    },
    "Thunderstorms expected with possible frequent lightning, localized hail and intense rain showers.": {
      "extractionState": "manual",
      "localizations": {
